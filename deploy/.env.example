# agent-sandbox episode - environment file template.
#
#   cp deploy/.env.example deploy/.env
#   $EDITOR deploy/.env
#   set -a && . deploy/.env && set +a
#
# deploy/.env is git-ignored (.gitignore); deploy/deploy.sh loads it
# automatically before its sanity guards. Everything below ships
# documentation placeholders - never commit real endpoints or tokens.

# --- Required (deploy.sh refuses to start without these) ---

# Your Dynatrace tenant API base, including the /api suffix.
# e.g. https://abc12345.live.dynatrace.com/api
DT_API_URL=https://YOUR_TENANT.live.dynatrace.com/api

# DynaKube / ActiveGate - cluster monitoring (README, Getting started 2).
DT_OPERATOR_TOKEN=dt0c01.XXXX

# OTLP ingest - used by the gateway collector (README, Getting started 2).
DT_INGEST_TOKEN=dt0c01.YYYY

# LAN IP of the host running ollama serve bound to 0.0.0.0.
OLLAMA_HOST=10.20.30.40

# An address from your MetalLB pool to publish the WebUI on. NOT cosmetic:
# OpenClaw Control UI refuses any other browser origin.
WEBUI_IP=10.20.30.241

# --- Optional (sensible defaults) ---

# Who may reach the WebUI. Defaults to the /24 of WEBUI_IP.
#LAN_CIDR=10.20.30.0/24

# Regenerated on every run when unset; set it to keep a stable gateway token.
#OPENCLAW_GATEWAY_TOKEN=change-me
